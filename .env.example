# Copy to .env and fill in. .env is ignored by git and read by docker compose.

# Signs the login tokens. Change it before going online.
JWT_SECRET=change-me-in-production

# How many proxies are really in front of the server (0 when it is exposed
# directly). Setting this higher than the truth lets anybody forge their
# address and walk past every rate limit.
TRUSTED_PROXIES=0

