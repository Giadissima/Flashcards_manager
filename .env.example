# Copy to .env and fill in. .env is ignored by git and read by docker compose.

# Signs the login tokens. Change it before going online.
JWT_SECRET=change-me-in-production

# The bot that announces reports, from @BotFather. It only ever sends: it
# reads nothing back, so a leaked token cannot moderate anything.
# Leave empty and the site works exactly the same, without it.
TELEGRAM_BOT_TOKEN=
# The chat the reports go to. Your own numeric id, which @userinfobot tells you
# (or write to your bot once and read it from getUpdates).
TELEGRAM_CHAT_ID=

# How many proxies are really in front of the server (0 when it is exposed
# directly). Setting this higher than the truth lets anybody forge their
# address and walk past every rate limit.
TRUSTED_PROXIES=0

# The password for the moderation page at /admin. Long, and only yours.
ADMIN_PASSWORD=

# Who carries the confirmation mails. Any SMTP server does - leave any of the
# host, the user or the password empty and the whole thing is off: whoever
# registers is taken at their word, and the site works exactly the same.
#
# A relay is the easy way in, because it needs no domain and no new mailbox:
# make an account at brevo.com (300 mails a day, free), verify the address you
# already read your mail at, and copy the SMTP key it gives you. Mailjet works
# the same way if you would rather. Port 587 is what they both want.
#
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USER=9a1b2c001@smtp-brevo.com   <- the login, not an address
#   MAIL_FROM=Flashcards Manager <you@example.com>   <- the verified sender
#
# A plain mailbox works too, with its own SMTP settings; there MAIL_USER is
# the address, and MAIL_FROM can be left empty. Note that the password is
# whatever that provider issues for programs - an app password, a key - and
# never the one you log in with by hand.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
# What the reader sees in the From line. Empty falls back to MAIL_USER, which
# is right for a mailbox and wrong for a relay - the server says so on startup.
MAIL_FROM=

# The address the site answers from: the bot links reports to it, and the
# confirmation mails send people back to it. Has to be the address a reader
# can really open, not localhost, the moment the site is online.
PUBLIC_URL=http://localhost:4200
